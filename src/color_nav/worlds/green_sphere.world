<sdf version="1.6">

  <world name="green_sphere_world">

    <!-- Physics -->

    <physics type="ode">

      <real_time_update_rate>
        1000.0
      </real_time_update_rate>

      <max_step_size>
        0.001
      </max_step_size>

      <real_time_factor>
        1.0
      </real_time_factor>

    </physics>

    <!-- Gazebo ROS -->

    <plugin
      name="gazebo_ros_init"
      filename="libgazebo_ros_init.so"/>

    <plugin
      name="gazebo_ros_factory"
      filename="libgazebo_ros_factory.so"/>

    <!-- Scene -->

    <scene>

      <ambient>
        0.8 0.8 0.8 1.0
      </ambient>

      <background>
        0.7 0.7 0.7 1.0
      </background>

      <shadows>false</shadows>

    </scene>

    <!-- Environment -->

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Green target -->

    <model name="green_sphere">

      <static>true</static>

      <pose>
        -4.5 0 0.35 0 0 0
      </pose>

      <link name="sphere_link">

        <visual name="sphere_visual">

          <geometry>

            <sphere>
              <radius>0.35</radius>
            </sphere>

          </geometry>

          <material>

            <ambient>
              0.0 0.8 0.0 1.0
            </ambient>

            <diffuse>
              0.0 0.8 0.0 1.0
            </diffuse>

            <specular>
              0.1 0.1 0.1 1.0
            </specular>

          </material>

        </visual>

        <collision name="sphere_collision">

          <geometry>

            <sphere>
              <radius>0.35</radius>
            </sphere>

          </geometry>

        </collision>

      </link>

    </model>

  </world>

</sdf>